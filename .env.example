# Copiez ce fichier en ".env" en local, ou renseignez ces variables dans les paramètres
# d'environnement de votre hébergeur (Render, Railway...) — ne jamais committer le vrai .env.

# --- Sécurité (optionnel) ---
# Restreint les appels à ce backend à votre seul domaine GestComPro une fois connu (sinon CORS reste
# ouvert à toute origine — le vrai verrou d'accès est APP_API_KEY, pas CORS).
ALLOWED_ORIGIN=

# --- Analyse IA (extraction de documents) — indépendante de la TTN ci-dessous, aucun rapport ---
GEMINI_API_KEY=colle_ici_ta_cle_aistudio_google
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Clé interne à VOTRE application, propre à l'Analyse IA (PAS un secret TTN, PAS la clé Google
# ci-dessus, PAS APP_API_KEY) — inventez une chaîne longue et aléatoire, à renseigner aussi dans
# GestComPro > Paramètres > 🤖 Lecture IA de documents > "Clé d'accès à la Lecture IA".
IA_API_KEY=choisissez_une_autre_cle_longue_et_aleatoire

# --- Relais TTN / El Fatoora (signature XAdES-BES + dépôt) — optionnel, uniquement si vous utilisez
# le bouton "Envoyer à la TTN" via ce backend plutôt que directement depuis le navigateur ---
# Clé interne à VOTRE application, propre à la TTN (PAS un secret TTN, PAS la clé IA_API_KEY
# ci-dessus) — inventez une chaîne longue et aléatoire, à renseigner aussi dans GestComPro >
# Paramètres > El Fatoora > "Clé API du relais TTN".
APP_API_KEY=choisissez_une_cle_longue_et_aleatoire

# --- Prospection (recherche d'entreprises + mise à jour des fiches) — facultatif ---
# Clé Google Cloud avec "Places API (New)" activée (console.cloud.google.com). Sans elle, la recherche
# utilise OpenStreetMap (gratuit, moins complet) et la mise à jour des fiches est indisponible.
# L'analyse IA des prospects utilise GEMINI_API_KEY ci-dessus ; l'accès se fait avec IA_API_KEY.
GOOGLE_PLACES_API_KEY=
# Facultatif : votre e-mail, ajouté à l'identification du serveur auprès d'OpenStreetMap (bonne
# pratique demandée par Nominatim). N'a aucun autre effet.
OSM_CONTACT=

# --- Plafonds de sécurité (audit du 28/09) — bornent les coûts si une clé d'accès fuitait ---
# Nombre maximum d'appels par jour (tous appareils confondus). Au-delà : refus jusqu'au lendemain.
IA_MAX_APPELS_JOUR=300
# Google Places : 30 par jour ≈ 900 recherches par mois, sous le quota gratuit mensuel de 1 000
# (palier « Text Search Enterprise », vérifier la grille Google). Un balayage de gouvernorat
# consomme une recherche par délégation. OpenStreetMap n'est pas concerné par ce plafond.
PLACES_MAX_APPELS_JOUR=30
